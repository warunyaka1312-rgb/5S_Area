<?php
require_once 'config.php';
$department=$_GET['department']??'Production';$view=$_GET['view']??'month';$month=$_GET['month']??'สิงหาคม';$year=(int)($_GET['year']??2569);$chart=$_GET['chart']??'group';$size=$_GET['size']??'A4';$target=target_pct($department);
if(!in_array($department,['Production','Office'],true))$department='Production'; if(!in_array($size,['A4','A3'],true))$size='A4';
$p=db();$months=['มกราคม'=>1,'กุมภาพันธ์'=>2,'มีนาคม'=>3,'เมษายน'=>4,'พฤษภาคม'=>5,'มิถุนายน'=>6,'กรกฎาคม'=>7,'สิงหาคม'=>8,'กันยายน'=>9,'ตุลาคม'=>10,'พฤศจิกายน'=>11,'ธันวาคม'=>12];
$scoreTable=$department==='Office'?'office_scores':'scores';$critTable=$department==='Office'?'office_criteria':'criteria';
$groups=[];$trend=[];
function graph_period_sql(PDO $p,string $dept,string $start,string $end,string $scoreTable,string $critTable):array{
    $q=$p->prepare("SELECT a.group_name,a.area_name,au.id audit_id,s.score1,s.score2,s.score3,c.max_score FROM audits au JOIN areas a ON a.id=au.area_id JOIN {$scoreTable} s ON s.audit_id=au.id JOIN {$critTable} c ON c.id=s.criterion_id WHERE au.department=? AND au.audit_date BETWEEN ? AND ? ORDER BY a.group_name,a.unit_no,au.id");
    $q->execute([$dept,$start,$end]);$tmp=[];
    foreach($q as $r){$v=score_avg($r['score1'],$r['score2'],$r['score3']);if($v===null)continue;$key=$r['area_name'];if(!isset($tmp[$key]))$tmp[$key]=['group_name'=>$r['area_name'],'score'=>0,'max'=>0,'audits'=>[]];$tmp[$key]['score']+=(float)$v;$tmp[$key]['max']+=(float)$r['max_score'];$tmp[$key]['audits'][$r['audit_id']]=1;}
    $out=[];foreach($tmp as $r)$out[]=['group_name'=>$r['group_name'],'avg'=>$r['max']?round($r['score']/$r['max']*100,2):0,'n'=>count($r['audits'])];usort($out,fn($a,$b)=>$b['avg']<=>$a['avg']);return $out;
}
if($chart==='trend'){
    for($mn=1;$mn<=12;$mn++){
        $st=sprintf('%04d-%02d-01',$year,$mn);$en=date('Y-m-t',strtotime($st));
        $rows=graph_period_sql($p,$department,$st,$en,$scoreTable,$critTable);$s=0;$n=0;foreach($rows as $r){$s += $r['avg'];$n++;}$trend[]=['month'=>array_search($mn,$months,true),'avg'=>$n?round($s/$n,2):null];
    }
}else{
    $mn=$months[$month]??(int)date('n');
    if($view==='year'){$st=sprintf('%04d-01-01',$year);$en=sprintf('%04d-12-31',$year);}else{$st=sprintf('%04d-%02d-01',$year,$mn);$en=date('Y-m-t',strtotime($st));}
    $groups=graph_period_sql($p,$department,$st,$en,$scoreTable,$critTable);
}
$title=$chart==='trend'?"แนวโน้มคะแนน 5 ส. รายเดือน — $department / $year":"คะแนน 5 ส. เปรียบเทียบกลุ่ม — $department / ".($view==='year'?"ปี $year":"$month $year");
?><!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><?=h($title)?></title><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script><style>*{box-sizing:border-box}body{font-family:Tahoma,Arial,sans-serif;margin:0;background:#fff;color:#111827}.page{width:100%;min-height:100vh;padding:14mm 16mm;display:flex;flex-direction:column}.head{display:flex;justify-content:space-between;align-items:center;border-bottom:4px solid #ff5a00;padding-bottom:8mm;margin-bottom:8mm}.brand{font-size:25px;font-weight:900}.brand span{color:#ff5a00}.title{font-size:23px;font-weight:900}.sub{font-size:14px;color:#475569;margin-top:4px}.chartbox{flex:1;min-height:0;position:relative}.foot{margin-top:6mm;border-top:1px solid #cbd5e1;padding-top:4mm;display:flex;justify-content:space-between;font-size:11px;color:#64748b}.no-print{position:fixed;top:12px;right:12px;z-index:10}.no-print button{padding:9px 14px;border:1px solid #cbd5e1;border-radius:9px;background:#fff;font-weight:800}@page{size:A4 landscape;margin:0}@media print{.no-print{display:none}.page{min-height:100vh}}body.a3 .page{padding:18mm 20mm}.a3 .title{font-size:30px}.a3 .brand{font-size:34px}@page a3{size:A3 landscape;margin:0}
</style></head><body class="<?=h(strtolower($size))?>"><div class="no-print"><button onclick="window.print()">🖨 พิมพ์ <?=$size?></button> <button onclick="downloadPNG()">⬇ PNG</button> <button onclick="copyPNG()">📋 คัดลอกรูป</button></div><div class="page"><div class="head"><div><div class="brand">5S <span>SMART | ALUMET</span></div><div class="sub">ระบบประเมินมาตรฐานกิจกรรม 5 ส.</div></div><div style="text-align:right"><div class="title"><?=h($title)?></div><div class="sub">จัดทำเพื่อพิมพ์ติดบอร์ด / A4 / A3</div></div></div><div class="chartbox"><canvas id="c"></canvas></div><div class="foot"><span>5S SMART SCORE SYSTEM | ALUMET</span><span>พิมพ์เมื่อ <?=date('d/m/Y H:i')?></span></div></div><script>
const orange='#ff5a00', red='#ef4444';
<?php if($chart==='trend'):?>const labels=<?=json_encode(array_column($trend,'month'),JSON_UNESCAPED_UNICODE)?>, vals=<?=json_encode(array_map(fn($x)=>$x['avg']===null?null:(float)$x['avg'],$trend))?>;new Chart(c,{type:'line',data:{labels,datasets:[{label:'คะแนนเฉลี่ย %',data:vals,borderColor:orange,backgroundColor:'rgba(255,90,0,.10)',fill:true,tension:.25,pointRadius:5,spanGaps:false},{label:'Target <?=h($target)?>%',data:labels.map(()=><?=json_encode($target)?>),borderColor:red,borderDash:[8,5],pointRadius:0}]},options:{responsive:true,maintainAspectRatio:false,scales:{y:{min:0,max:100,ticks:{stepSize:20,callback:v=>v+'%'},title:{display:true,text:'คะแนน (%)',font:{size:14,weight:'700'}}},x:{ticks:{font:{size:13,weight:'700'}}}},plugins:{legend:{position:'top',labels:{font:{size:13,weight:'700'}}},tooltip:{callbacks:{label:c=>c.datasetIndex===1?' Target <?=h($target)?>%':' '+Number(c.parsed.y).toFixed(2)+'%'}}}}});<?php else:?>const labels=<?=json_encode(array_column($groups,'group_name'),JSON_UNESCAPED_UNICODE)?>, vals=<?=json_encode(array_map(fn($x)=>(float)$x['avg'],$groups))?>;new Chart(c,{type:'bar',data:{labels,datasets:[{label:'คะแนนเฉลี่ย %',data:vals,backgroundColor:'rgba(255,90,0,.82)',borderColor:orange,borderWidth:1,borderRadius:8,maxBarThickness:48},{label:'Target <?=h($target)?>%',type:'line',data:labels.map(()=><?=json_encode($target)?>),borderColor:red,borderDash:[8,5],pointRadius:0,borderWidth:2}]},options:{responsive:true,maintainAspectRatio:false,scales:{y:{min:0,max:100,ticks:{stepSize:20,callback:v=>v+'%'},title:{display:true,text:'คะแนน (%)',font:{size:14,weight:'700'}}},x:{ticks:{font:{size:13,weight:'700'},maxRotation:0}}},plugins:{legend:{position:'top',labels:{font:{size:13,weight:'700'}}},tooltip:{callbacks:{label:c=>c.datasetIndex===1?' Target <?=h($target)?>%':' '+Number(c.parsed.y).toFixed(2)+'%'}}}}});<?php endif;?>
function downloadPNG(){const a=document.createElement('a');a.href=c.toDataURL('image/png',1);a.download='5S_<?=h($department)?>_<?=h($year)?>.png';a.click();}
async function copyPNG(){try{const blob=await new Promise(r=>c.toBlob(r,'image/png'));await navigator.clipboard.write([new ClipboardItem({'image/png':blob})]);alert('คัดลอกรูปแล้ว สามารถกด Ctrl+V ใน LINE ได้');}catch(e){downloadPNG();alert('คัดลอกตรงไม่ได้ จึงดาวน์โหลด PNG ให้แทนครับ');}}
</script></body></html>