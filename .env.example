# ==================================================================
# 5S SMART | ALUMET — ตัวอย่างไฟล์ตั้งค่า
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเซิร์ฟเวอร์
# (ถ้าไม่มี .env ระบบจะใช้ค่าเริ่มต้นตามตัวอย่างนี้)
# ==================================================================

# ---------- ฐานข้อมูล MySQL / MariaDB ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=five_s_smart
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ---------- แอพ ----------
APP_NAME="5S Smart Score"
APP_VERSION=V71
APP_TIMEZONE=Asia/Bangkok

# ---------- เข้าสู่ระบบ ----------
SESSION_NAME=FIVES_SMART
ADMIN_DEFAULT_PASSWORD=admin1234

# ---------- งานอัตโนมัติ ----------
AUTO_BACKUP_KEEP=30
AUTO_SYNC_MINUTES=10
